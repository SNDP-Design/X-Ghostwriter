rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUser(data) {
      // Fields: email, displayName, photoURL, lastLogin
      let keys = data.keys();
      return keys.hasAll(['email', 'lastLogin']) &&
             keys.size() <= 4 &&
             data.email is string && data.email.size() <= 256 &&
             data.lastLogin == request.time &&
             (!('displayName' in data) || data.displayName is string || data.displayName == null) &&
             (!('photoURL' in data) || data.photoURL is string || data.photoURL == null);
    }

    function isValidHistory(data) {
      // Fields: userId, timestamp, request, result
      return data.keys().hasAll(['userId', 'timestamp', 'request', 'result']) &&
             data.keys().size() == 4 &&
             data.userId == request.auth.uid &&
             data.timestamp == request.time &&
             data.request is map &&
             data.result is map &&
             data.request.topic is string && data.request.topic.size() <= 2000 &&
             data.request.role is string && data.request.role.size() <= 500;
    }

    // User profile and data
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(incoming());
      
      match /history/{historyId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidHistory(incoming()) && isValidId(historyId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
