{
  "manifest_version": 3,
  "name": "XGhostwriter",
  "version": "1.0.0",
  "description": "Generate viral tweet ideas directly from your sidebar.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://*.run.app/*",
    "https://*.google.com/*"
  ],
  "action": {
    "default_title": "Open XGhostwriter"
  },
  "side_panel": {
    "default_path": "extension.html"
  },
  "minimum_chrome_version": "114",
  "background": {
    "service_worker": "background.js"
  }
}
